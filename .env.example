# Copy to .env only when .env does not already exist; preserve existing keys.
# npm run setup:relay creates a real private demo Relay workspace only if no key
# is configured. It writes RELAY_WORKSPACE_KEY without printing it. Never commit .env.
# To reuse an existing Relay workspace, set its non-empty key instead:
# RELAY_WORKSPACE_KEY=
APP_ORIGIN=http://localhost:4310
PORT=4310
HOST=127.0.0.1
DATA_DIR=.data

# Optional real invitation email delivery: configure BOTH values and verify your
# sender domain with Resend. Leave both unset for manual invitation link sharing;
# a partially configured pair is an explicit startup error.
# RESEND_API_KEY=
# MAIL_FROM=Gazetteer <shipments@your-verified-domain.example>

# Remote teammates also need a reachable HTTPS deployment: set APP_ORIGIN to its
# origin, bind HOST=0.0.0.0 behind a TLS proxy, and persist DATA_DIR and .env.
# A localhost invitation is not remotely reachable; no deployment is created here.
