# Copy to .env. npm run setup:relay creates a private demo Relay workspace and
# writes RELAY_WORKSPACE_KEY without printing it. Never commit .env.
APP_ORIGIN=http://localhost:4310
PORT=4310
HOST=127.0.0.1
DATA_DIR=.data

# Optional real invitation email delivery. Without these, invitations return
# an email-bound link for manual sharing; the UI does not claim email was sent.
# RESEND_API_KEY=
# MAIL_FROM=Gazetteer <shipments@your-verified-domain.example>
