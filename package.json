{
  "name": "gazetteer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "check": "tsc --noEmit",
