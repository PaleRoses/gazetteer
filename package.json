{
  "name": "gazetteer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "bun src/server/main.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:runtime": "GAZETTEER_RUNTIME_INTEGRATION=1 bun test test/server/runtime/monitoring.integration.test.ts",
    "setup:relay": "bun scripts/setup-relay.ts",
    "acceptance": "bun scripts/acceptance.ts",
    "verify": "tsc --noEmit && knip && depcruise src && bun test && bun scripts/check-actors.ts && vite build"
  },
  "dependencies": {
    "@agent-relay/sdk": "15.0.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "^1.3.0",
    "@ark-ui/solid": "^5.40.0",
    "@hono/zod-validator": "^0.9.1",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "durable-actors": "0.14.6",
    "effect": "^4.1.1",
    "h3-js": "^4.5.0",
    "hono": "^4.13.14",
    "lucide-solid": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "mqtt": "^5.16.1",
    "solid-js": "^1.9.18",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@types/bun": "^1.3.0",
    "@types/geojson": "^7946.0.16",
    "bun": "1.4.4",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.1",
    "searoute-ts": "^2.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
