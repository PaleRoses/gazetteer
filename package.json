    "setup:relay": "bun src/server/setup-relay.ts"
  },
  "dependencies": {
    "@agent-relay/sdk": "15.0.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "durable-actors": "0.14.6",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "bun": "1.4.4",
    "searoute-ts": "^2.3.1",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
